{
  "netlist": "dc-swing-body.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "sf",
      "fs"
    ],
    "supply_v": {
      "vdd": [
        1.62
      ]
    },
    "temperature_c": [
      -40.0
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "Vsw 0 1.000001 0.00277777777778"
  },
  "measurements": [
    {
      "name": "vout_mid_v",
      "unit": "V",
      "spice": ".meas dc vout_mid_v find v(out) at=0.5"
    }
  ],
  "options": {
    "timeout_s": 600,
    "keep_artifacts": true,
    "waveforms": true
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 600
  }
}
