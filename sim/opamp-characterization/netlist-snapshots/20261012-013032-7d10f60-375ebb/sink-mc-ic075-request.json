{
  "netlist": "sink-mc-ic075-body.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt_mm"
    ],
    "supply_v": {
      "vdd": [
        1.8
      ]
    },
    "temperature_c": [
      27.0
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "Vinp 0 1m 1m"
  },
  "measurements": [
    {
      "name": "i_vdd_a",
      "unit": "A",
      "spice": ".meas dc i_vdd_a find i(vdd) at=0"
    },
    {
      "name": "i_xms_a",
      "unit": "A",
      "spice": ".meas dc i_xms_a find i(v.xdut.vxms) at=0"
    },
    {
      "name": "vout_v",
      "unit": "V",
      "spice": ".meas dc vout_v find v(out) at=0"
    }
  ],
  "options": {
    "timeout_s": 600,
    "keep_artifacts": true
  },
  "batch": {
    "runner_version_check": "warn"
  },
  "monte_carlo": {
    "n": 100,
    "seed": 20261198,
    "vary": "mismatch"
  }
}
