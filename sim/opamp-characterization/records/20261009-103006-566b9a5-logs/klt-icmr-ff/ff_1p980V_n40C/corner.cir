.temp -40.0
.meas dc vout_mid_v find v(out_1) at=0.99
.meas dc vid_mid_v find v(vid1) at=0.99
.meas dc iq_mid_a find i(vsense) at=0.99
.meas dc k_mid find v(k) at=0.99
