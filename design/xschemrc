#### Project-local xschem configuration for sky130-opamp (issue #13).
####
#### Purpose: make `xschem` find the sky130 symbol library without relying on
#### anything in the user's ~/.xschem, so batch netlisting and interactive
#### editing share one config. Ported from the same-PDK sibling
#### sky130-bandgap/sim/xschemrc, with the repo-library and netlist-directory
#### blocks arranged the way this block's three-foundry twin
#### sg13g2-opamp/design/xschemrc does (netlists land in design/netlist/,
#### next to the schematic they came from, so they are reviewable in git).
####
#### Load it explicitly and unambiguously:
####   xschem --rcfile design/xschemrc design/opamp_core.sch
#### (cwd-relative "./xschemrc" auto-discovery only fires when xschem's cwd
#### happens to be this directory.)

#### PDK_ROOT / PDK: honour the environment, else fall back to the volare
#### default root. Keep the fallback in sync with
#### sim/gm-id-characterization/pdk.json ("default_pdk_root": "~/.volare",
#### "variant": "sky130A").
if {![info exists env(PDK_ROOT)] || $env(PDK_ROOT) eq {}} {
  set env(PDK_ROOT) [file normalize ~/.volare]
}
if {![info exists env(PDK)] || $env(PDK) eq {}} {
  set env(PDK) sky130A
}

#### Everything PDK-specific is inherited from the PDK's own xschemrc, which
#### sets XSCHEM_LIBRARY_PATH so `sky130_fd_pr/*.sym` resolves and defines the
#### fet_drc proc this design's device widths are checked against (see
#### spec/decision-records/DR-002-device-sizing.md, "minimum-width floor").
set _sky130_rc $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
if {![file exists $_sky130_rc]} {
  puts stderr "sky130-opamp: no PDK xschemrc at $_sky130_rc"
  puts stderr "sky130-opamp: install the pinned PDK (see sim/gm-id-characterization/pdk.json)"
  puts stderr "sky130-opamp: or set PDK_ROOT / PDK and restart xschem."
} else {
  source $_sky130_rc
}
unset _sky130_rc

#### Put the repository root and design/ on the symbol search path so this
#### project's own cells resolve by their repo-relative name (e.g.
#### `design/opamp_core.sym`) rather than by an absolute, machine-local path.
#### Appended *after* the PDK entries so a project symbol can never shadow a
#### `sky130_fd_pr/*` one.
set _repo_root [file normalize [file join [file dirname [info script]] ..]]
if {![info exists XSCHEM_LIBRARY_PATH] || $XSCHEM_LIBRARY_PATH eq {}} {
  set XSCHEM_LIBRARY_PATH $_repo_root
} else {
  append XSCHEM_LIBRARY_PATH ":$_repo_root"
}
append XSCHEM_LIBRARY_PATH ":[file join $_repo_root design]"

# Testbenches live at sim/<experiment-slug>/testbench/ (fleet convention, see
# sim/README.md) -- this glob is a no-op until a sim/ experiment has one.
foreach _tb_dir [glob -nocomplain -type d [file join $_repo_root sim * testbench]] {
  append XSCHEM_LIBRARY_PATH ":$_tb_dir"
}
catch {unset _tb_dir}
unset _repo_root

#### Netlists land next to the schematic they came from, not in a scratch
#### dir, so the ngspice fragment a future testbench includes is reviewable
#### in git. The documented regeneration command overrides this with an
#### explicit `-o`, so this only affects interactive netlisting from the GUI.
set netlist_dir [file normalize [file join [file dirname [info script]] netlist]]
file mkdir $netlist_dir

#### Do not open the PDK's demo schematic when started with no file argument.
set XSCHEM_START_WINDOW {}
